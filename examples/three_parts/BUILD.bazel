load("@rules_lilypond//lilypond:defs.bzl", "lilypond_pdf", "lilypond_library", "lilypond_parts_pdfs", "lilypond_book")

TITLE = "Excerpt from the 7th Symphony"
COMPOSER = "Gustav Mahler"
DEP_MAP = {
    ":tpt1": "tptOne",
    ":tpt2": "tptTwo",
    ":tpt3": "tptThree",
}
MUSIC_INST_MAP = {
    "tptOne": "Trumpet I in Bb",
    "tptTwo": "Trumpet II in Bb",
    "tptThree": "Trumpet III in Bb",
}
MUSIC_SHORT_INST_MAP = {
    "tptOne": "Tpt I",
    "tptTwo": "Tpt II",
    "tptThree": "Tpt III",
}

lilypond_pdf(
    name = "score",
    deps = [":score_book"],
)

lilypond_parts_pdfs(
    name = "parts",
    music_inst_map = MUSIC_INST_MAP,
    title = TITLE,
    composer = COMPOSER,
    warning_as_error = False,  # TODO: Fix "decrescendo too small".
    dep_map = DEP_MAP,
)

lilypond_book(
    name = "score_book",
    skip_bars = False,
    music_inst_map = MUSIC_INST_MAP,
    music_short_inst_map = MUSIC_SHORT_INST_MAP,
    title = TITLE,
    composer = COMPOSER,
    deps = DEP_MAP.keys(),
)

lilypond_library(
    name = "tpt1",
    srcs = ["tpt1-notes.ly"],
)

lilypond_library(
    name = "tpt2",
    srcs = ["tpt2-notes.ly"],
)

lilypond_library(
    name = "tpt3",
    srcs = ["tpt3-notes.ly"],
)
