load("@rules_lilypond//lilypond:defs.bzl", "lilypond_pdf", "lilypond_library", "lilypond_book")

TITLE = "Excerpt from the 7th Symphony"
COMPOSER = "Gustav Mahler"

lilypond_pdf(
    name = "score",
    deps = [":score_book"],
)

lilypond_pdf(
    name = "parts",
    deps = [":parts_book"],
    warning_as_error = False,  # TODO: Fix "decrescendo too small".
)

lilypond_book(
    name = "score_book",
    skip_bars = False,
    title = TITLE,
    composer = COMPOSER,
    deps = [
        ":tpt1_notes",
        ":tpt2_notes",
        ":tpt3_notes",
    ],
)

lilypond_book(
    name = "parts_book",
    parts = True,
    title = TITLE,
    composer = COMPOSER,
    deps = [
        ":tpt1_notes",
        ":tpt2_notes",
        ":tpt3_notes",
    ],
)

lilypond_library(
    name = "tpt1_notes",
    srcs = ["tpt1-notes.ly"],
    music_var = "tptOne",
    instrument = "Trumpet I in Bb",
    short_instrument = "Tpt I",
)

lilypond_library(
    name = "tpt2_notes",
    srcs = ["tpt2-notes.ly"],
    music_var = "tptTwo",
    instrument = "Trumpet II in Bb",
    short_instrument = "Tpt II",
)

lilypond_library(
    name = "tpt3_notes",
    srcs = ["tpt3-notes.ly"],
    music_var = "tptThree",
    instrument = "Trumpet III in Bb",
    short_instrument = "Tpt III",
)
