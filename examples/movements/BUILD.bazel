load("@rules_lilypond//lilypond:defs.bzl", "lilypond_pdf", "lilypond_library", "lilypond_book")

# For testing.
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:select_file.bzl", "select_file")

TITLE = "Movements of Grandeur"
COMPOSER = "Claude H. IV (and a half)"

lilypond_pdf(
    name = "movements",
    deps = [
        ":parts",
        ":score"
    ],
)

lilypond_book(
    name = "parts",
    parts = True,
    title = TITLE,
    composer = COMPOSER,
    deps = [
        ":soprano_mvmt1_notes",
        ":bass_mvmt1_notes",
        ":soprano_mvmt2_notes",
        ":bass_mvmt2_notes",
        ":soprano_mvmt3_notes",
        ":bass_mvmt3_notes",
    ],
)

lilypond_book(
    name = "score",
    skip_bars = False,
    title = TITLE,
    composer = COMPOSER,
    deps = [
        ":soprano_mvmt1_notes",
        ":bass_mvmt1_notes",
        ":soprano_mvmt2_notes",
        ":bass_mvmt2_notes",
        ":soprano_mvmt3_notes",
        ":bass_mvmt3_notes",
    ],
)

lilypond_library(
    name = "soprano_mvmt1_notes",
    srcs = ["soprano-mvmt1-notes.ly"],
    music_var = "sopranoMvmtOne",
    instrument = "Soprano",
    movement = "I - Andante",
)

lilypond_library(
    name = "bass_mvmt1_notes",
    srcs = ["bass-mvmt1-notes.ly"],
    music_var = "bassMvmtOne",
    instrument = "Bass",
    movement = "I - Andante",
)

lilypond_library(
    name = "soprano_mvmt2_notes",
    srcs = ["soprano-mvmt2-notes.ly"],
    music_var = "sopranoMvmtTwo",
    instrument = "Soprano",
    movement = "II - Scherzo",
)

lilypond_library(
    name = "bass_mvmt2_notes",
    srcs = ["bass-mvmt2-notes.ly"],
    music_var = "bassMvmtTwo",
    instrument = "Bass",
    movement = "II - Scherzo",
)

lilypond_library(
    name = "soprano_mvmt3_notes",
    srcs = ["soprano-mvmt3-notes.ly"],
    music_var = "sopranoMvmtThree",
    instrument = "Soprano",
    movement = "III - Finale",
)

lilypond_library(
    name = "bass_mvmt3_notes",
    srcs = ["bass-mvmt3-notes.ly"],
    music_var = "bassMvmtThree",
    instrument = "Bass",
    movement = "III - Finale",
)

# The remainder of the file is for testing. You may disregard.

diff_test(
    name = "score_test",
    file1 = "testdata/score.ly",
    file2 = ":score",
)

PART_NAMES = [
    "Soprano",
    "Bass",
]

[diff_test(
    name = "parts_{}_test".format(name),
    file1 = "testdata/parts_{}.ly".format(name),
    file2 = ":parts_{}".format(name),
) for name in PART_NAMES]

[select_file(
    name = "parts_{}".format(name),
    srcs = ":parts",
    subpath = "parts_{}.ly".format(name),
) for name in PART_NAMES]
